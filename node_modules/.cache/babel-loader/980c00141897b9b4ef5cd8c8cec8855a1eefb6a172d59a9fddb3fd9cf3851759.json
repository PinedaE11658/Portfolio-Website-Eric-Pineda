ading = false;\r\n    }\r\n  },\r\n};\r\n</script>\r\n\r\n\r\n<style scoped>\r\n.portfolio-box {\r\n  background-color: #daeaf6;\r\n  padding: 1rem;\r\n  border-radius: 8px;\r\n  box-shadow: 0 25px 9px rgba(0, 0, 0, 0.1);\r\n  max-width: 700px;\r\n  width: 100%;\r\n}\r\n.portfolio-box ul {\r\n  list-style-type: none;\r\n  padding: 0;\r\n}\r\n\r\n.portfolio-box li {\r\n  margin-bottom: 1.5rem;\r\n  padding: 1rem;\r\n  border-bottom: 1px solid #ccc;\r\n}\r\n</style>"],"mappings":"AAoBA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,YAAY,EAAE,EAAE;MAChBC,OAAO,EAAE,IAAI;MACbC,KAAK,EAAE;IACT,CAAC;EACH,CAAC;EACD,MAAMC,OAAOA,CAAA,EAAG;IACd,IAAI;MACF,MAAMC,QAAO,GAAI,MAAMN,KAAK,CAACO,GAAG,CAAC,iDAAiD,CAAC;MACnF,IAAI,CAACL,YAAW,GAAII,QAAQ,CAACL,IAAI;IACnC,EAAE,OAAOG,KAAK,EAAE;MACd,IAAI,CAACA,KAAI,GAAI,6BAA6B;IAC5C,UAAU;MACR,IAAI,CAACD,OAAM,GAAI,KAAK;IACtB;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}