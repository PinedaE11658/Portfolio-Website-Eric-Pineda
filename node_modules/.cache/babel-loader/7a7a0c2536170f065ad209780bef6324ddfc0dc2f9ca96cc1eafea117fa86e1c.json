{"ast":null,"code":"import \"core-js/modules/esnext.iterator.map.js\";\nimport axios from 'axios';\nexport default {\n  name: 'RunescapePage',\n  data() {\n    return {\n      accounts: [],\n      loading: true,\n      error: null\n    };\n  },\n  created() {\n    this.fetchAccounts();\n  },\n  methods: {\n    async fetchAccounts() {\n      try {\n        const response = await axios.get('https://secure.runescape.com/m=hiscore/index_lite.ws?player=Loyal_hex');\n\n        // Parse CSV response into structured data\n        const lines = response.data.split('\\n');\n        const parsed = lines.map(line => {\n          const [rank, level, xp] = line.split(',');\n          return {\n            rank,\n            level,\n            xp\n          };\n        });\n        this.accounts = parsed;\n      } catch (error) {\n        this.error = 'Failed to load Runescape accounts';\n      } finally {\n        this.loading = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","accounts","loading","error","created","fetchAccounts","methods","response","get","lines","split","parsed","map","line","rank","level","xp"],"sources":["C:\\Users\\Eric\\OneDrive\\Documents\\GitHub\\Portfolio-Website-Eric-Pineda\\src\\views\\Runescape.vue"],"sourcesContent":["<template>\r\n  <div class=\"runescape-box\">\r\n    <h1>Runescape Accounts</h1>\r\n    <p>Hello!</p>\r\n    <div v-if=\"loading\">Loading...</div>\r\n    <div v-if=\"error\">{{ error }}</div> \r\n\r\n    <ul v-if=\"accounts.length > 0\">\r\n      <li v-for=\"(account, index) in accounts\" :key=\"index\">\r\n        <p><strong>Skill {{ index }}:</strong></p>\r\n        <p>Rank: {{ account.rank }}</p>\r\n        <p>Level: {{ account.level }}</p>\r\n        <p>XP: {{ account.xp }}</p>\r\n        <hr>\r\n      </li>\r\n    </ul>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios'\r\n\r\nexport default {\r\n  name: 'RunescapePage',\r\n  data() {\r\n    return {\r\n      accounts: [],\r\n      loading: true,\r\n      error: null,\r\n    }\r\n  },\r\n  created() {\r\n    this.fetchAccounts()\r\n  },\r\n  methods: {\r\n    async fetchAccounts() {\r\n      try {\r\n        const response = await axios.get(\r\n          'https://secure.runescape.com/m=hiscore/index_lite.ws?player=Loyal_hex'\r\n        )\r\n\r\n        // Parse CSV response into structured data\r\n        const lines = response.data.split('\\n')\r\n        const parsed = lines.map((line) => {\r\n          const [rank, level, xp] = line.split(',')\r\n          return { rank, level, xp }\r\n        })\r\n\r\n        this.accounts = parsed\r\n      } catch (error) {\r\n        this.error = 'Failed to load Runescape accounts'\r\n      } finally {\r\n        this.loading = false\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.runescape-box {\r\n  background-color: #E8DFF5;\r\n  padding: 100px;\r\n  border-radius: 20px;\r\n  max-width: 500px;\r\n  box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);\r\n  text-align: center;\r\n}\r\n</style>"],"mappings":";AAoBA,OAAOA,KAAI,MAAO,OAAM;AAExB,eAAe;EACbC,IAAI,EAAE,eAAe;EACrBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE;MACZC,OAAO,EAAE,IAAI;MACbC,KAAK,EAAE;IACT;EACF,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,aAAa,CAAC;EACrB,CAAC;EACDC,OAAO,EAAE;IACP,MAAMD,aAAaA,CAAA,EAAG;MACpB,IAAI;QACF,MAAME,QAAO,GAAI,MAAMT,KAAK,CAACU,GAAG,CAC9B,uEACF;;QAEA;QACA,MAAMC,KAAI,GAAIF,QAAQ,CAACP,IAAI,CAACU,KAAK,CAAC,IAAI;QACtC,MAAMC,MAAK,GAAIF,KAAK,CAACG,GAAG,CAAEC,IAAI,IAAK;UACjC,MAAM,CAACC,IAAI,EAAEC,KAAK,EAAEC,EAAE,IAAIH,IAAI,CAACH,KAAK,CAAC,GAAG;UACxC,OAAO;YAAEI,IAAI;YAAEC,KAAK;YAAEC;UAAG;QAC3B,CAAC;QAED,IAAI,CAACf,QAAO,GAAIU,MAAK;MACvB,EAAE,OAAOR,KAAK,EAAE;QACd,IAAI,CAACA,KAAI,GAAI,mCAAkC;MACjD,UAAU;QACR,IAAI,CAACD,OAAM,GAAI,KAAI;MACrB;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}