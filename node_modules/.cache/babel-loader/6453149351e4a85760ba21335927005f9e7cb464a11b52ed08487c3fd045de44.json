turn {\r\n        formData: {\r\n          name: \"\",\r\n          email: \"\",\r\n          message: \"\",\r\n        },\r\n      };\r\n    },\r\n    methods: {\r\n      submitForm() {\r\n        console.log(\"Form submitted:\", this.formData);\r\n        alert(`Thank you, ${this.formData.name}! Your message has been sent!`);\r\n        // Reset the form\r\n        this.formData.name = \"\";\r\n        this.formData.email = \"\";\r\n        this.formData.message = \"\";\r\n      },\r\n    },\r\n  };\r\n  </script>\r\n  \r\n  <style scoped>\r\n  \r\n  .contact-box {\r\n    background-color: #E8DFF5;\r\n    padding: 20px;\r\n    border-radius: 20px;\r\n    max-width: 500px;\r\n    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);\r\n    text-align: center;\r\n  }\r\n  \r\n  .contact-box h1 {\r\n    margin-top: 0;\r\n    font-size: 2rem;\r\n    color: #333;\r\n  }\r\n  \r\n  .contact-form {\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 20px;\r\n  }\r\n  \r\n  .form-group {\r\n    display: flex;\r\n    flex-direction: column;\r\n    text-align: left;\r\n  }\r\n  \r\n  .form-group label {\r\n    margin-bottom: 5px;\r\n    font-size: 1rem;\r\n    color: #444;\r\n  }\r\n  \r\n  .form-group input,\r\n  .form-group textarea {\r\n    padding: 10px;\r\n    border: 1px solid #ccc;\r\n    border-radius: 5px;\r\n    font-size: 1rem;\r\n    color: #333;\r\n  }\r\n  \r\n  .submit-button {\r\n    padding: 10px 20px;\r\n    background-color: #aca6b6;\r\n    color: white;\r\n    border: none;\r\n    border-radius: 5px;\r\n    font-size: 1rem;\r\n    cursor: pointer;\r\n    transition: background-color 0.3s;\r\n  }\r\n  \r\n  .submit-button:hover {\r\n    background-color: #56535a;\r\n  }\r\n  </style>\r\n  "],"mappings":"AAyBE,eAAe;EACbA,IAAI,EAAE,aAAa;EACnBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE;QACRF,IAAI,EAAE,EAAE;QACRG,KAAK,EAAE,EAAE;QACTC,OAAO,EAAE;MACX;IACF,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACPC,UAAUA,CAAA,EAAG;MACXC,OAAO,CAACC,GAAG,CAAC,iBAAiB,EAAE,IAAI,CAACN,QA